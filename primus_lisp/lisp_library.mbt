        #|
        #|(defun untrust/string (p)
        #|  "taints a string pointed by P (except the terminating null)"
        #|  (untrust/region p (strlen p)))
        #|
        #|;; Rule:
        #|;; r = atoi(a), r = atol(a), r = atoll(a) |- T(r), T(a,strlen(a))
        #|;;
        #|;; Motivation:
        #|;; The textual representation of numeric data as an
