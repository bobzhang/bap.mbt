// Per-opcode decoding tests of the native PowerPC decoder. Every expected
// line (the LLVM opcode name, the operands and the assembly) and the kinds
// (the MCInstrDesc flags of the opcode) are the output of LLVM 22's
// `llvm-mc -disassemble -show-inst` (triples `powerpc-linux-gnu` for `R32`
// and `powerpc64-linux-gnu` for `R64`, default CPU) for the big-endian word;
// the samples cover one encoding per distinct opcode and printed mnemonic
// (plus `ZERO` bases, negative displacements and absolute branch targets in
// both modes), taken from compiled C code, encoding-space sweeps and random
// words.

///|
let llvm_samples : Array[(@powerpc.AddrSize, UInt32, String, String)] = [
