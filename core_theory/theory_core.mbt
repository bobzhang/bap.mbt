) -> Pure {
  (self.storew)(dir, mem, key, x)
}

///|
/// `arshift x m` is the arithmetic right shift.
pub fn Core::arshift(self : Core, x : Pure, m : Pure) -> Pure {
  (self.arshift)(x, m)
}

///|
/// `rshift x m` is the logical right shift.
pub fn Core::rshift(self : Core, x : Pure, m : Pure) -> Pure {
  (self.rshift)(x, m)
}

///|
/// `lshift x m` is the left shift.
pub fn Core::lshift(self : Core, x : Pure, m : Pure) -> Pure {
  (self.lshift)(x, m)
}

///|
/// `eq x y` is the equality predicate.
pub fn Core::eq(self : Core, x : Pure, y : Pure) -> Pure {
  (self.eq)(x, y)
}

///|
/// `neq x y` is the disequality predicate.
pub fn Core::neq(self : Core, x : Pure, y : Pure) -> Pure {
  (self.neq)(x, y)
}

///|
/// `slt x y` is the signed less than predicate.
pub fn Core::slt(self : Core, x : Pure, y : Pure) -> Pure {
  (self.slt)(x, y)
}

///|
/// `ult x y` is the unsigned less than predicate.
pub fn Core::ult(self : Core, x : Pure, y : Pure) -> Pure {
  (self.ult)(x, y)
}

///|
/// `sgt x y` is the signed greater than predicate.
pub fn Core::sgt(self : Core, x : Pure, y : Pure) -> Pure {
  (self.sgt)(x, y)
}

///|
/// `ugt x y` is the unsigned greater than predicate.
pub fn Core::ugt(self : Core, x : Pure, y : Pure) -> Pure {
  (self.ugt)(x, y)
}

///|
/// `sge x y` is the signed greater or equal predicate.
pub fn Core::sge(self : Core, x : Pure, y : Pure) -> Pure {
  (self.sge)(x, y)
}

///|
/// `uge x y` is the unsigned greater or equal predicate.
pub fn Core::uge(self : Core, x : Pure, y : Pure) -> Pure {
  (self.uge)(x, y)
}

///|
/// `float s x` interprets the bitvector `x` as a float of sort `s`.
pub fn Core::float(self : Core, s : Sort, x : Pure) -> Pure {
  (self.float)(s, x)
}

///|
/// `fbits x` is the bitvector representation of the float `x`.
pub fn Core::fbits(self : Core, x : Pure) -> Pure {
  (self.fbits)(x)
}

///|
/// `is_finite x` holds if `x` is finite.
pub fn Core::is_finite(self : Core, x : Pure) -> Pure {
  (self.is_finite)(x)
}

///|
/// `is_nan x` holds if `x` is not a number.
pub fn Core::is_nan(self : Core, x : Pure) -> Pure {
  (self.is_nan)(x)
}

///|
/// `is_inf x` holds if `x` is an infinity.
pub fn Core::is_inf(self : Core, x : Pure) -> Pure {
  (self.is_inf)(x)
}

///|
/// `is_fzero x` holds if `x` is a zero.
pub fn Core::is_fzero(self : Core, x : Pure) -> Pure {
  (self.is_fzero)(x)
}

///|
/// `is_fpos x` holds if `x` is positive.
pub fn Core::is_fpos(self : Core, x : Pure) -> Pure {
  (self.is_fpos)(x)
}

///|
/// `is_fneg x` holds if `x` is negative.
pub fn Core::is_fneg(self : Core, x : Pure) -> Pure {
  (self.is_fneg)(x)
}

///|
/// `rne`: round to nearest, ties to even.
pub fn Core::rne(self : Core) -> Pure {
  self.rne
}

///|
/// `rna`: round to nearest, ties away.
pub fn Core::rna(self : Core) -> Pure {
  self.rna
}

///|
/// `rtp`: round towards positive.
pub fn Core::rtp(self : Core) -> Pure {
  self.rtp
}

///|
/// `rtn`: round towards negative.
pub fn Core::rtn(self : Core) -> Pure {
  self.rtn
}

///|
/// `rtz`: round towards zero.
pub fn Core::rtz(self : Core) -> Pure {
  self.rtz
}

///|
/// `requal x y` holds if the rounding modes are equal.
pub fn Core::requal(self : Core, x : Pure, y : Pure) -> Pure {
  (self.requal)(x, y)
}

///|
/// `cast_float s rm x` is the unsigned integer `x` as a float of sort `s`.
pub fn Core::cast_float(self : Core, s : Sort, rm : Pure, x : Pure) -> Pure {
  (self.cast_float)(s, rm, x)
}

///|
/// `cast_sfloat s rm x` is the signed integer `x` as a float of sort `s`.
pub fn Core::cast_sfloat(self : Core, s : Sort, rm : Pure, x : Pure) -> Pure {
  (self.cast_sfloat)(s, rm, x)
}

///|
/// `cast_int s rm x` is the float `x` as an unsigned integer of sort `s`.
pub fn Core::cast_int(self : Core, s : Sort, rm : Pure, x : Pure) -> Pure {
  (self.cast_int)(s, rm, x)
}

///|
/// `cast_sint s rm x` is the float `x` as a signed integer of sort `s`.
pub fn Core::cast_sint(self : Core, s : Sort, rm : Pure, x : Pure) -> Pure {
  (self.cast_sint)(s, rm, x)
}

///|
/// `fneg x` is `-x`.
pub fn Core::fneg(self : Core, x : Pure) -> Pure {
  (self.fneg)(x)
}

///|
/// `fabs x` is the absolute value of `x`.
pub fn Core::fabs(self : Core, x : Pure) -> Pure {
  (self.fabs)(x)
}

///|
/// `fadd rm x y` is the floating-point add rounded with `rm`.
pub fn Core::fadd(self : Core, rm : Pure, x : Pure, y : Pure) -> Pure {
  (self.fadd)(rm, x, y)
}

///|
/// `fsub rm x y` is the floating-point sub rounded with `rm`.
pub fn Core::fsub(self : Core, rm : Pure, x : Pure, y : Pure) -> Pure {
  (self.fsub)(rm, x, y)
}

///|
/// `fmul rm x y` is the floating-point mul rounded with `rm`.
pub fn Core::fmul(self : Core, rm : Pure, x : Pure, y : Pure) -> Pure {
  (self.fmul)(rm, x, y)
}

///|
/// `fdiv rm x y` is the floating-point div rounded with `rm`.
pub fn Core::fdiv(self : Core, rm : Pure, x : Pure, y : Pure) -> Pure {
  (self.fdiv)(rm, x, y)
}

///|
/// `fsqrt rm x` is the square root of `x`.
pub fn Core::fsqrt(self : Core, rm : Pure, x : Pure) -> Pure {
  (self.fsqrt)(rm, x)
}

///|
/// `fmodulo rm x y` is the floating-point remainder.
pub fn Core::fmodulo(self : Core, rm : Pure, x : Pure, y : Pure) -> Pure {
  (self.fmodulo)(rm, x, y)
}

///|
/// `fmad rm x y z` is `x * y + z` rounded once.
pub fn Core::fmad(self : Core, rm : Pure, x : Pure, y : Pure, z : Pure) -> Pure {
  (self.fmad)(rm, x, y, z)
}

///|
/// `fround rm x` rounds `x` to an integral float.
pub fn Core::fround(self : Core, rm : Pure, x : Pure) -> Pure {
  (self.fround)(rm, x)
}

///|
/// `fconvert s rm x` converts the float `x` to the float sort `s`.
pub fn Core::fconvert(self : Core, s : Sort, rm : Pure, x : Pure) -> Pure {
  (self.fconvert)(s, rm, x)
}

///|
/// `fsucc x` is the least float greater than `x`.
pub fn Core::fsucc(self : Core, x : Pure) -> Pure {
  (self.fsucc)(x)
}

///|
/// `fpred x` is the greatest float less than `x`.
pub fn Core::fpred(self : Core, x : Pure) -> Pure {
  (self.fpred)(x)
}

///|
/// `forder x y` holds if `x` is strictly less than `y`.
pub fn Core::forder(self : Core, x : Pure, y : Pure) -> Pure {
  (self.forder)(x, y)
}

///|
/// `pow rm x y`.
pub fn Core::pow(self : Core, rm : Pure, x : Pure, y : Pure) -> Pure {
  (self.pow)(rm, x, y)
}

