import {
  "bobzhang/bap/types",
  "moonbitlang/core/bigint",
  "moonbitlang/core/encoding/utf8",
}

// Z3 is loaded with dlopen at run time (see z3_stub.c): no Z3 headers or
// link flags are needed. The dynamic loader is part of libc on macOS and
// glibc >= 2.34; older glibc needs `-ldl` in the final link.

options(
  "native-stub": [ "z3_stub.c" ],
  targets: {
    "ffi_native.mbt": [ "native" ],
    "ffi_stub.mbt": [ "wasm", "wasm-gc", "js", "llvm" ],
    "z3_native_test.mbt": [ "native" ],
  },
)
