// Differential semantic testing of the x86 lifters against Unicorn.
//
// The `cases_*_test.mbt` tables were generated by assembling instructions
// with llvm-mc 22 and executing them one at a time in Unicorn 2.1.4 from
// random initial states. Each line of a table is one case:
//
//   asm|hex bytes|LLVM MCInst|initial state|expected final state
//
// The MCInst (`NAME:op,...`, registers as `%NAME`, `%` for no register)
// was obtained by disassembling the bytes with `llvm-mc -show-inst`.
// Initial state: `reg=hex` (full general purpose registers), `xmmN=hex`,
// `f=hex` (EFLAGS) and `mADDR=hex bytes` (memory). Everything else has the
// default value (`default_gpr`, `default_xmm`, `default_region`: the same
// formulas as the generator). Expected state: `reg=hex` (changed
// registers), `reg=?` (undefined by the SDM, not compared), `xmmN=hex`,
// `f=value/undefined-mask` (the flags the SDM leaves undefined are
// masked), `mADDR=bytes` (changed memory), `m=?` (memory not compared),
// `j=hex` (the next instruction address, when not the fall-through) and
// `e=N` (a CPU exception). Registers, flags and memory not mentioned must
// be unchanged.
//
// The Basic lifter is given the instruction decoded by the project's Basic
// decoder, the `x86` providers and the Primus Lisp semantics are given
// LLVM's MCInst (with the raw bytes), and the legacy x86 lifter decodes the
// bytes itself. The lifted BIL is executed with an interpreter built on
// `Exp::eval_value` (the evaluator of `@types.exec_stmts`) that tolerates
// `unknown` values (undefined flags), checks the width of every
// assignment, stops at the first jump or CPU exception, and re-executes
// REP string instructions that jump back to themselves (upstream lifts one
// iteration per execution); the final state is then compared.

///|
const CODE : UInt64 = 0x400000

///|
const DATA : UInt64 = 0x10000

///|
const STACK : UInt64 = 0x20000

///|
const REGION : Int = 1024

///|
let gpr64_names : Array[String] = [
  "RAX", "RCX", "RDX", "RBX", "RSP", "RBP", "RSI", "RDI", "R8", "R9", "R10", "R11",
  "R12", "R13", "R14", "R15",
]

///|
let gpr32_names : Array[String] = [
  "EAX", "ECX", "EDX", "EBX", "ESP", "EBP", "ESI", "EDI",
]

///|
let flag_bits : Array[(String, Int)] = [
  ("CF", 0),
  ("PF", 2),
  ("AF", 4),
  ("ZF", 6),
  ("SF", 7),
  ("DF", 10),
  ("OF", 11),
]

///|
priv struct Case {
  mode : Int
  text : String
  code : Bytes
  mc : String
  regs : Map[Int, UInt64]
  xmms : Map[Int, String]
  flags : Int
  mem : Array[(UInt64, Bytes)]
  exp_regs : Map[Int, UInt64?]
  exp_xmms : Map[Int, String?]
  exp_flags : Int
  undef_flags : Int
  exp_mem : Array[(UInt64, Bytes)]
  mem_dontcare : Bool
  jump : UInt64?
  exn : Int?
}

///|
fn nregs(mode : Int) -> Int {
  if mode == 64 {
    16
  } else {
    8
  }
}

///|
fn gpr_names(mode : Int) -> Array[String] {
  if mode == 64 {
    gpr64_names
  } else {
    gpr32_names
  }
}

///|
fn parse_hex(s : StringView) -> UInt64 raise {
  let mut v = 0UL
  for c in s {
    let d = match c {
      '0'..='9' => c.to_int() - '0'.to_int()
      'a'..='f' => c.to_int() - 'a'.to_int() + 10
      'A'..='F' => c.to_int() - 'A'.to_int() + 10
      _ => fail("bad hex \{s}")
    }
    v = (v << 4) | d.to_uint64()
  }
  v
}

///|
fn parse_dec(s : StringView) -> Int64 raise {
  let mut v = 0L
  for c in s {
    guard c is ('0'..='9') else { fail("bad number \{s}") }
    v = v * 10L + (c.to_int() - '0'.to_int()).to_int64()
  }
  v
}

///|
fn parse_bytes(s : StringView) -> Bytes raise {
  let n = s.length() / 2
  let out = FixedArray::make(n, b'\x00')
  for i in 0..<n {
    out[i] = parse_hex(s.view(start_offset=2 * i, end_offset=2 * i + 2)).to_byte()
  }
  Bytes::from_array(out)
}

///|
fn reg_index(mode : Int, name : StringView) -> Int? {
  let upper = name.to_owned().to_upper()
  gpr_names(mode).search(upper)
}

///|
fn parse_case(mode : Int, line : StringView) -> Case raise {
  let parts = line.split("|").collect()
  guard parts.length() == 5 else { fail("bad case: \{line}") }
  let regs = Map([])
  let xmms = Map([])
  let mut flags = 2
  let mem = []
  for item in parts[3].split(" ") {
    if item.is_empty() {
      continue
    }
    guard item.find("=") is Some(eq) else { fail("bad item \{item}") }
    let key = item.view(end_offset=eq)
    let value = item.view(start_offset=eq + 1)
    if key == "f" {
      flags = parse_hex(value).to_int()
    } else if key.has_prefix("xmm") {
      xmms[parse_dec(key.view(start_offset=3)).to_int()] = value.to_owned()
    } else if key.has_prefix("m") {
      mem.push((parse_hex(key.view(start_offset=1)), parse_bytes(value)))
    } else {
      guard reg_index(mode, key) is Some(i) else { fail("bad reg \{key}") }
      regs[i] = parse_hex(value)
    }
  }
  let exp_regs = Map([])
  let exp_xmms = Map([])
  let mut exp_flags = 0
  let mut undef_flags = 0
  let exp_mem = []
  let mut jump = None
  let mut exn = None
  let mut mem_dontcare = false
  for item in parts[4].split(" ") {
    if item.is_empty() {
      continue
    }
    guard item.find("=") is Some(eq) else { fail("bad item \{item}") }
    let key = item.view(end_offset=eq)
    let value = item.view(start_offset=eq + 1)
    if key == "f" {
      guard value.find("/") is Some(sl) else { fail("bad flags \{value}") }
      exp_flags = parse_hex(value.view(end_offset=sl)).to_int()
      undef_flags = parse_hex(value.view(start_offset=sl + 1)).to_int()
    } else if key == "j" {
      jump = Some(parse_hex(value))
    } else if key == "m" && value == "?" {
      mem_dontcare = true
    } else if key == "e" {
      exn = Some(parse_dec(value).to_int())
    } else if key.has_prefix("xmm") {
      exp_xmms[parse_dec(key.view(start_offset=3)).to_int()] = if value == "?" {
        None
      } else {
        Some(value.to_owned())
      }
    } else if key.has_prefix("m") {
      exp_mem.push((parse_hex(key.view(start_offset=1)), parse_bytes(value)))
    } else {
      guard reg_index(mode, key) is Some(i) else { fail("bad reg \{key}") }
      exp_regs[i] = if value == "?" { None } else { Some(parse_hex(value)) }
    }
  }
  {
    mode,
    text: parts[0].to_owned(),
    code: parse_bytes(parts[1]),
    mc: parts[2].to_owned(),
    regs,
    xmms,
    flags,
    mem,
    exp_regs,
    exp_xmms,
    exp_flags,
    undef_flags,
    exp_mem,
    mem_dontcare,
    jump,
    exn,
  }
}

///|
fn parse_cases(mode : Int, table : String) -> Array[Case] raise {
  let out = []
  for line in table.split("\n") {
    if !line.is_empty() {
      out.push(parse_case(mode, line))
    }
  }
  out
}

// The default machine state (the generator's formulas).

///|
fn default_gpr(i : Int, mode : Int) -> UInt64 {
  let v = match i {
    4 => STACK + 0x100
    5 => STACK + 0x180
    6 => DATA + 0x80
    7 => DATA + 0x100
    _ => (0x0123456789ABCDEFUL * (i + 1).to_uint64()) ^ 0x5A5A5A5A5A5A5A5AUL
  }
  if mode == 64 {
    v
  } else {
    v & 0xffffffff
  }
}

///|
fn default_xmm(i : Int) -> (UInt64, UInt64) {
  let lo = (0x0123456789ABCDEFUL * (i + 3).to_uint64()) ^ 0x1111111111111111UL
  let hi = (0xFEDCBA9876543210UL * (i + 5).to_uint64()) ^ 0x2222222222222222UL
  (hi, lo)
}

///|
fn default_region(base : UInt64) -> Bytes {
  if base == DATA {
    default_data
  } else {
    default_stack
  }
}

///|
let default_data : Bytes = Bytes::makei(REGION, i => {
  ((i * 37 + 11) & 0xff).to_byte()
})

///|
let default_stack : Bytes = Bytes::makei(REGION, i => {
  ((i * 91 + 7) & 0xff).to_byte()
})

///|
fn word(width : Int, value : UInt64) -> @types.BilValue {
  BilWord(try! @types.Word::of_uint64(width~, value))
}

///|
fn xmm_word(hex : String) -> @types.Word raise {
  @types.Word::from_hex(width=128, hex)
}

///|
fn default_xmm_word(i : Int) -> @types.Word raise {
  let (hi, lo) = default_xmm(i)
  @types.Word::of_uint64(width=64, hi).concat(
    @types.Word::of_uint64(width=64, lo),
  )
}

///|
/// The expected bytes of the two memory regions: `(base, bytes)`.
fn regions(
  updates : Array[(UInt64, Bytes)],
  more? : Array[(UInt64, Bytes)] = [],
) -> Array[(UInt64, Bytes)] {
  let out = []
  for base in [DATA, STACK] {
    let init = default_region(base)
    let bytes = FixedArray::makei(REGION, i => init[i])
    for u in updates.iter().concat(more.iter()) {
      let (addr, data) = u
      for k, b in data {
        let a = addr + k.to_uint64()
        if a >= base - 256 && a < base - 256 + REGION.to_uint64() {
          bytes[(a - (base - 256)).to_int()] = b
        }
      }
    }
    out.push((base - 256, Bytes::from_array(bytes)))
  }
  out
}

///|
/// The canonical initial state: full registers (YMM for the vector
/// registers), the flags, the segment and control registers and memory.
fn initial_state(c : Case) -> Map[String, @types.BilValue] raise {
  let w = c.mode
  let values : Map[String, @types.BilValue] = Map([])
  for i, name in gpr_names(w) {
    values[name] = word(w, c.regs.get(i).unwrap_or(default_gpr(i, w)))
  }
  for f in flag_bits {
    values[f.0] = word(1, ((c.flags >> f.1) & 1).to_uint64())
  }
  for i in 0..<nregs(w) {
    let x = match c.xmms.get(i) {
      Some(h) => xmm_word(h)
      None => default_xmm_word(i)
    }
    let v = @types.Word::of_uint64(width=128, 0).concat(x)
    values["YMM\{i}"] = BilWord(v)
  }
  values["FS_BASE"] = word(w, 0)
  values["GS_BASE"] = word(w, 0)
  for s in ["CS", "DS", "ES", "FS", "GS", "SS"] {
    values[s] = word(16, 0x2b)
  }
  values["FPU_CONTROL"] = word(16, 0x37f)
  values["MXCSR"] = word(32, 0x1f80)
  let mut mem = base_memory(w)
  for u in c.mem {
    let (addr, data) = u
    for k, b in data {
      let a = try! @types.Word::of_uint64(width=w, addr + k.to_uint64())
      mem = match
        mem.store(
          a,
          try! @types.Word::of_uint64(width=8, b.to_uint64()),
          endian=LittleEndian,
        ) {
        Ok(m) => m
        Err(e) => fail(e)
      }
    }
  }
  values["mem"] = BilMem(mem)
  values
}

///|
let base_memories : Map[Int, @types.BilMemory] = Map([])

///|
/// The default memory of the test states (cached per address width).
fn base_memory(w : Int) -> @types.BilMemory raise {
  match base_memories.get(w) {
    Some(m) => m
    None => {
      let mut mem = @types.BilMemory::empty(addr_width=w)
      for r in regions([]) {
        let data = @types.Word::from_bytes(r.1, endian=LittleEndian)
        mem = match
          mem.store(
            @types.Word::of_uint64(width=w, r.0),
            data,
            endian=LittleEndian,
          ) {
          Ok(m) => m
          Err(e) => fail(e)
        }
      }
      base_memories[w] = mem
      mem
    }
  }
}
