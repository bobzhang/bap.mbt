        #|
        #|(defun popcount64 (x)
        #|  (declare (visibility :private))
        #|  (popcount/helper x 56
        #|                   0x5555555555555555:64
        #|                   0x3333333333333333:64
        #|                   0x0f0f0f0f0f0f0f0f:64
        #|                   0x0101010101010101:64))
        #|
        #|(defun clz8 (r)
        #|  (declare (visibility :private))
        #|  (let ((x r))
        #|    (set x (logor x (rshift x 1)))
        #|    (set x (logor x (rshift x 2)))
        #|    (set x (logor x (rshift x 4)))
        #|    (set x (lnot x))
        #|    (popcount8 x)))
        #|
        #|(defun clz16 (r)
        #|  (declare (visibility :private))
        #|  (let ((x r))
        #|    (set x (logor x (rshift x 1)))
        #|    (set x (logor x (rshift x 2)))
        #|    (set x (logor x (rshift x 4)))
        #|    (set x (logor x (rshift x 8)))
        #|    (set x (lnot x))
        #|    (popcount16 x)))
        #|
        #|(defun clz32 (x)
        #|  (declare (visibility :private))
        #|  (let ((x x))
        #|    (set x (logor x (rshift x 1)))
        #|    (set x (logor x (rshift x 2)))
        #|    (set x (logor x (rshift x 4)))
        #|    (set x (logor x (rshift x 8)))
        #|    (set x (logor x (rshift x 16)))
        #|    (set x (lnot x))
        #|    (popcount32 x)))
        #|
        #|(defun clz64 (x)
        #|  (declare (visibility :private))
        #|  (let ((x x))
        #|    (set x (logor x (rshift x 1)))
        #|    (set x (logor x (rshift x 2)))
        #|    (set x (logor x (rshift x 4)))
        #|    (set x (logor x (rshift x 8)))
        #|    (set x (logor x (rshift x 16)))
        #|    (set x (logor x (rshift x 32)))
        #|    (set x (lnot x))
        #|    (popcount64 x)))
        #|
        #|(defun clz/rec (x)
        #|  (declare (visibility :private))
        #|  (if (> (word-width x) 64)
        #|        (if (is-zero (cast-high 64 x))
        #|            (+ 64 (clz (cast-low (- (word-width x) 64) x)))
        #|          (clz64 (cast-high 64 x)))
        #|    (clz x)))
        #|
        #|(defun clz/small (x)
        #|  (declare (visibility :private))
        #|  (let ((w (word-width x)))
        #|    (if       (< w 8)  (- (clz8  (cast-unsigned 8 x))  (- 8 w))
        #|      (if     (< w 16) (- (clz16 (cast-unsigned 16 x)) (- 16 w))
        #|        (if   (< w 32) (- (clz32 (cast-unsigned 32 x)) (- 32 w))
        #|          (if (< w 64) (- (clz64 (cast-unsigned 64 x)) (- 64 w))
        #|            (clz x)))))))
        #|
      ),
    ),
    (
      "semantics/primus/dummy.lisp",
      (
        #|;; a dummy file to prevent build and install scripts from failing
        #|;; will remove it in the future
        #|
      ),
    ),
    (
      "semantics/primus/ieee754.lisp",
      (
        #|(defpackage intrinsic (:use core target))
        #|
        #|(in-package intrinsic)
        #|
        #|(declare (global x0 x1 x2 y0))
        #|
        #|(defun fadd_rne_ieee754_binary ()
        #|  (set y0 (+. :rne x0 x1)))
        #|
        #|(defun fsub_rne_ieee754_binary ()
        #|  (set y0 (-. :rne x0 x1)))
        #|
        #|(defun fmul_rne_ieee754_binary ()
        #|  (set y0 (*. :rne x0 x1)))
        #|
        #|(defun fdiv_rne_ieee754_binary ()
        #|  (set y0 (/. :rne x0 x1)))
        #|
        #|(defun forder_ieee754_binary ()
        #|  (set y0 (<. x0 x1)))
        #|
        #|(defun is_nan_ieee754_binary ()
        #|  (set y0 (is-nan x0)))
        #|
        #|(defun cast_sfloat_rne_ieee754_binary_64 ()
        #|  (set y0 (cast-sfloat :rne 64 x0)))
        #|
        #|(defun cast_float_rne_ieee754_binary_64 ()
        #|  (set y0 (cast-float :rne 64 x0)))
        #|
        #|(defun cast_sint_rne_ieee754_binary_64 ()
        #|  (set y0 (cast-sint :rne 64 x0)))
        #|
        #|(defun cast_int_rne_ieee754_binary_64 ()
        #|  (set y0 (cast-int :rne 64 x0)))
        #|
      ),
    ),
    (
      "semantics/riscv/riscv.lisp",
      (
        #|(declare (context (target riscv)))
        #|(defpackage riscv (:use core target program))
        #|(defpackage llvm-riscv64 (:use riscv riscv64))
        #|(defpackage llvm-riscv32 (:use riscv riscv32))
        #|(in-package riscv)
        #|
        #|;;; The BAP MoonBit port: the definitions follow the RISC-V ISA for the
        #|;;; operands produced by LLVM's disassembler (and the port's native
        #|;;; decoder). Definitions marked "port:" deliberately deviate from
        #|;;; upstream's `plugins/riscv/semantics/riscv.lisp`, or are not defined
        #|;;; upstream.
        #|
        #|;;; Helpers
        #|
        #|(defun word-bits (bits x)
        #|  "(word-bits BITS X) sign-extends the low BITS bits of X to the register
        #|   width (the result of a *W instruction). port: not in upstream."
        #|  (declare (visibility :private))
        #|  (cast-signed (word-width) (cast-low bits x)))
        #|
        #|(defun shift-amount (x)
        #|  "(shift-amount X) the low 5 (RV32) or 6 (RV64) bits of X. port: not in
        #|   upstream."
        #|  (declare (visibility :private))
        #|  (logand x (- (word-width) 1)))
        #|
        #|;;; Core Arithmetic
        #|
        #|(defun ADDI (dst src off)
        #|  (set$ dst (+ src off)))
        #|
        #|(defun C_ADDI (dst src off)
        #|  (set$ dst (+ src off)))
        #|
        #|(defun add3 (dst src off)
        #|  (declare (visibility :private))
        #|  (set$ dst (cast-signed
        #|             (word-width)
        #|             (cast-low (/ (word-width) 2)
        #|                       (+ src off)))))
        #|
        #|(defun ADDIW (dst src off)
        #|  (add3 dst src off))
        #|
        #|(defun C_ADDIW (dst src off)
        #|  (add3 dst src off))
        #|
        #|(defun ADDW (dst src off)
        #|  (add3 dst src off))
        #|
        #|(defun C_ADDW (rd r1 r2)
        #|  (add3 rd r1 r2))
        #|
        #|(defun ADD (rd r1 r2)
        #|  "port: not in upstream."
        #|  (set$ rd (+ r1 r2)))
        #|
        #|(defun C_ADD (rd r1 r2)
        #|  (set$ rd (+ r1 r2)))
        #|
        #|(defun C_ADDI4SPN (dst src off)
        #|  (set$ dst (+ src off)))
        #|
        #|(defun C_ADDI16SP (dst src off)
        #|  (set$ dst (+ src off)))
        #|
        #|(defun SUB (rd r1 r2)
        #|  (set$ rd (- r1 r2)))
        #|
        #|(defun C_SUB (rd r1 r2)
        #|  (set$ rd (- r1 r2)))
        #|
        #|(defun SUBW (rd r1 r2)
        #|  "port: not in upstream."
        #|  (set$ rd (word-bits 32 (- r1 r2))))
        #|
        #|(defun C_SUBW (rd r1 r2)
        #|  "port: not in upstream."
        #|  (set$ rd (word-bits 32 (- r1 r2))))
        #|
        #|;;; Multiplication and division (the M extension; port: not in upstream)
        #|
        #|(defun double-width ()
        #|  (declare (visibility :private))
        #|  (* 2 (word-width)))
        #|
        #|(defun MUL (rd r1 r2)
        #|  (set$ rd (* r1 r2)))
        #|
        #|(defun MULH (rd r1 r2)
        #|  (set$ rd (cast-high (word-width)
        #|                      (* (cast-signed (double-width) r1)
        #|                         (cast-signed (double-width) r2)))))
        #|
        #|(defun MULHU (rd r1 r2)
        #|  (set$ rd (cast-high (word-width)
        #|                      (* (cast-unsigned (double-width) r1)
        #|                         (cast-unsigned (double-width) r2)))))
        #|
        #|(defun MULHSU (rd r1 r2)
        #|  (set$ rd (cast-high (word-width)
        #|                      (* (cast-signed (double-width) r1)
        #|                         (cast-unsigned (double-width) r2)))))
        #|
        #|(defun DIV (rd r1 r2)
        #|  (if (is-zero r2)
        #|      (set$ rd -1)
        #|    (set$ rd (s/ r1 r2))))
        #|
        #|(defun DIVU (rd r1 r2)
        #|  (if (is-zero r2)
        #|      (set$ rd -1)
        #|    (set$ rd (/ r1 r2))))
        #|
        #|(defun REM (rd r1 r2)
        #|  (if (is-zero r2)
        #|      (set$ rd r1)
        #|    (set$ rd (signed-mod r1 r2))))
        #|
        #|(defun REMU (rd r1 r2)
        #|  (if (is-zero r2)
        #|      (set$ rd r1)
        #|    (set$ rd (mod r1 r2))))
        #|
        #|(defun MULW (rd r1 r2)
        #|  (set$ rd (word-bits 32 (* r1 r2))))
        #|
        #|(defun DIVW (rd r1 r2)
        #|  (let ((a (cast-low 32 r1))
        #|        (b (cast-low 32 r2)))
        #|    (if (is-zero b)
        #|        (set$ rd -1)
        #|      (set$ rd (word-bits 32 (s/ a b))))))
        #|
        #|(defun DIVUW (rd r1 r2)
        #|  (let ((a (cast-low 32 r1))
        #|        (b (cast-low 32 r2)))
        #|    (if (is-zero b)
        #|        (set$ rd -1)
        #|      (set$ rd (word-bits 32 (/ a b))))))
        #|
        #|(defun REMW (rd r1 r2)
        #|  (let ((a (cast-low 32 r1))
        #|        (b (cast-low 32 r2)))
        #|    (if (is-zero b)
        #|        (set$ rd (word-bits 32 a))
        #|      (set$ rd (word-bits 32 (signed-mod a b))))))
        #|
        #|(defun REMUW (rd r1 r2)
        #|  (let ((a (cast-low 32 r1))
        #|        (b (cast-low 32 r2)))
        #|    (if (is-zero b)
        #|        (set$ rd (word-bits 32 a))
        #|      (set$ rd (word-bits 32 (mod a b))))))
        #|
        #|;;; Moves
        #|
        #|(defun C_MV (dst src)
        #|  (set$ dst src))
        #|
        #|(defun upper (imm)
        #|  "(upper IMM) the 20-bit upper immediate IMM shifted into place and
        #|   sign-extended from 32 bits. port: upstream does not sign-extend."
        #|  (declare (visibility :private))
        #|  (word-bits 32 (lshift imm 12)))
        #|
        #|(defun C_LUI (dst imm)
        #|  (set$ dst (upper imm)))
        #|
        #|(defun AUIPC (dst off)
        #|  "port: upstream adds the unshifted immediate."
        #|  (set$ dst (+ (get-program-counter) (upper off))))
        #|
        #|(defun LUI (dst imm)
        #|  (set$ dst (upper imm)))
        #|
        #|(defun LI (dst imm)
        #|  (set$ dst (cast-signed (word-width) imm)))
        #|
        #|(defun C_LI (dst imm)
        #|  (set$ dst (cast-signed (word-width) imm)))
        #|
        #|;;; Memory operations
        #|
        #|(defmacro load-bits-as (cast bits dst reg off)
        #|  "port: loads BITS bits (upstream loads a fraction of the word width,
        #|   which is wrong on RV32)."
        #|  (set$ dst (cast (word-width) (load-bits bits (+ reg off)))))
        #|
        #|(defun LD (dst reg off)
        #|  (set$ dst (core:load-word (+ reg off))))
        #|
        #|(defun C_LD (dst reg off)
        #|  (set$ dst (core:load-word (+ reg off))))
        #|
        #|(defun C_LDSP (dst reg off)
        #|  (set$ dst (core:load-word (+ reg off))))
        #|
        #|(defun LW (dst reg off)
        #|  (load-bits-as cast-signed 32 dst reg off))
        #|
        #|(defun C_LW (dst reg off)
        #|  (load-bits-as cast-signed 32 dst reg off))
        #|
        #|(defun C_LWSP (dst reg off)
        #|  "port: not in upstream."
        #|  (load-bits-as cast-signed 32 dst reg off))
        #|
        #|(defun LWU (dst reg off)
        #|  (load-bits-as cast-unsigned 32 dst reg off))
        #|
        #|(defun LH (dst reg off)
        #|  (load-bits-as cast-signed 16 dst reg off))
        #|
        #|(defun LHU (dst reg off)
        #|  (load-bits-as cast-unsigned 16 dst reg off))
        #|
        #|(defun LB (dst reg off)
        #|  (set$ dst (cast-signed (word-width) (load-byte (+ reg off)))))
        #|
        #|(defun LBU (dst reg off)
        #|  (set$ dst (cast-unsigned (word-width) (load-byte (+ reg off)))))
        #|
        #|(defun C_SDSP (val sp imm)
        #|  (store-word (+ sp imm) val))
        #|
        #|(defun SDSP (val sp imm)
        #|  (store-word (+ sp imm) val))
        #|
        #|(defun SD (val reg imm)
        #|  (store-word (+ reg imm) val))
        #|
        #|(defun C_SD (val reg imm)
        #|  (store-word (+ reg imm) val))
        #|
        #|(defun SW (val reg imm)
        #|  "port: stores 32 bits (upstream stores half of the word width)."
        #|  (store-word (+ reg imm) (cast-low 32 val)))
        #|
        #|(defun C_SW (val reg imm)
        #|  "port: not in upstream."
        #|  (store-word (+ reg imm) (cast-low 32 val)))
        #|
        #|(defun C_SWSP (val reg imm)
        #|  "port: not in upstream."
        #|  (store-word (+ reg imm) (cast-low 32 val)))
        #|
        #|(defun SH (val reg imm)
        #|  "port: stores 16 bits (upstream stores a quarter of the word width)."
        #|  (store-word (+ reg imm) (cast-low 16 val)))
        #|
        #|(defun SB (val reg imm)
        #|  (store-byte (+ reg imm) val))
        #|
        #|;;; Bitwise Operations
        #|
        #|(defun ANDI (dst src off)
        #|  (set$ dst (logand src off)))
        #|
        #|(defun ORI (dst src off)
        #|  (set$ dst (logor src off)))
        #|
        #|(defun XORI (dst src off)
        #|  (set$ dst (logxor src off)))
        #|
        #|(defun AND (rd r1 r2)
        #|  "port: not in upstream."
        #|  (set$ rd (logand r1 r2)))
        #|
        #|(defun OR (rd r1 r2)
        #|  "port: not in upstream."
        #|  (set$ rd (logor r1 r2)))
        #|
        #|(defun XOR (rd r1 r2)
        #|  "port: not in upstream."
        #|  (set$ rd (logxor r1 r2)))
        #|
        #|(defun C_ANDI (dst src off)
        #|  "port: not in upstream."
        #|  (set$ dst (logand src off)))
        #|
        #|(defun C_AND (rd r1 r2)
        #|  "port: not in upstream."
        #|  (set$ rd (logand r1 r2)))
        #|
        #|(defun C_OR (rd r1 r2)
        #|  "port: not in upstream."
        #|  (set$ rd (logor r1 r2)))
        #|
        #|(defun C_XOR (rd r1 r2)
        #|  "port: not in upstream."
        #|  (set$ rd (logxor r1 r2)))
        #|
        #|(defun SRLI (dst reg off)
        #|  (set$ dst (rshift reg off)))
        #|
        #|(defun C_SRLI (dst reg off)
        #|  (set$ dst (rshift reg off)))
        #|
        #|(defun C_SRAI (dst src imm)
        #|  (set$ dst (arshift src imm)))
        #|
        #|(defun SRAI (dst src imm)
        #|  (set$ dst (arshift src imm)))
        #|
        #|(defun SLLI (dst reg off)
        #|  (set$ dst (lshift reg off)))
        #|
        #|(defun C_SLLI (dst reg off)
        #|  (set$ dst (lshift reg off)))
        #|
        #|;; register shifts use the low 5 (RV32) or 6 (RV64) bits of the amount;
        #|;; the *W shifts operate on the low words (port: not in upstream)
        #|
        #|(defun SLL (rd r1 r2)
        #|  (set$ rd (lshift r1 (shift-amount r2))))
        #|
        #|(defun SRL (rd r1 r2)
        #|  (set$ rd (rshift r1 (shift-amount r2))))
        #|
        #|(defun SRA (rd r1 r2)
        #|  (set$ rd (arshift r1 (shift-amount r2))))
        #|
        #|(defun SLLIW (rd r1 imm)
        #|  (set$ rd (word-bits 32 (lshift (cast-low 32 r1) imm))))
        #|
        #|(defun SRLIW (rd r1 imm)
        #|  (set$ rd (word-bits 32 (rshift (cast-low 32 r1) imm))))
        #|
        #|(defun SRAIW (rd r1 imm)
        #|  (set$ rd (word-bits 32 (arshift (cast-low 32 r1) imm))))
        #|
        #|(defun SLLW (rd r1 r2)
        #|  (set$ rd (word-bits 32 (lshift (cast-low 32 r1) (logand r2 31)))))
        #|
        #|(defun SRLW (rd r1 r2)
        #|  (set$ rd (word-bits 32 (rshift (cast-low 32 r1) (logand r2 31)))))
        #|
        #|(defun SRAW (rd r1 r2)
        #|  (set$ rd (word-bits 32 (arshift (cast-low 32 r1) (logand r2 31)))))
        #|
        #|;;; Comparison
        #|
        #|(defun SLTI (dst src off)
        #|  "port: a signed comparison of SRC (upstream compares DST, unsigned)."
        #|  (set$ dst (s< src off)))
        #|
        #|(defun SLTIU (dst src off)
        #|  "port: not in upstream."
        #|  (set$ dst (< src off)))
        #|
        #|(defun SLT (rd r1 r2)
        #|  "port: not in upstream."
        #|  (set$ rd (s< r1 r2)))
        #|
        #|(defun SLTU (rd r1 r2)
        #|  "port: not in upstream."
        #|  (set$ rd (< r1 r2)))
        #|
        #|;;; Jumps
        #|
        #|(defun JAL (lr off)
        #|  (let ((pc (get-program-counter)))
        #|    (set$ lr (+ pc 4))
        #|    (exec-addr (+ pc off))))
        #|
        #|(defun C_JAL (off)
        #|  "port: not in upstream."
        #|  (let ((pc (get-program-counter)))
        #|    (set X1 (+ pc 2))
        #|    (exec-addr (+ pc off))))
        #|
        #|(defun JALR (lr rs off)
        #|  "port: jumps to (RS + OFF) & ~1, read before LR is written (upstream
        #|   jumps to PC + RS + OFF)."
        #|  (let ((pc (get-program-counter))
        #|        (dst (logand (+ rs off) (lnot 1))))
        #|    (set$ lr (+ pc 4))
        #|    (exec-addr dst)))
        #|
        #|(defun C_JR (dst)
        #|  "port: jumps to DST & ~1, as JALR (upstream keeps bit 0)."
        #|  (exec-addr (logand dst (lnot 1))))
        #|
        #|(defun C_J (dst)
        #|  (exec-addr (+ (get-program-counter) dst)))
        #|
        #|(defun C_JALR (dst)
        #|  "port: jumps to DST & ~1, as JALR, read before X1 is written."
        #|  (let ((target (logand dst (lnot 1))))
        #|    (set X1 (+ (get-program-counter) 2))
        #|    (exec-addr target)))
        #|
        #|(defun conditional-jump (cmp off)
        #|  (declare (visibility :private))
        #|  (let ((pc (get-program-counter)))
        #|    (when cmp
        #|      (exec-addr (+ pc off)))))
        #|
        #|(defun BEQ (rs1 rs2 off)
        #|  (conditional-jump (= rs1 rs2) off))
        #|
        #|(defun BLT (rs1 rs2 off)
        #|  "port: a signed comparison (upstream: unsigned)."
        #|  (conditional-jump (s< rs1 rs2) off))
        #|
        #|(defun BNE (rs1 rs2 off)
        #|  (conditional-jump (/= rs1 rs2) off))
        #|
        #|(defun BGE (rs1 rs2 off)
        #|  "port: a signed comparison (upstream: unsigned)."
        #|  (conditional-jump (s>= rs1 rs2) off))
        #|
        #|(defun BLTU (rs1 rs2 off)
        #|  "port: not in upstream."
        #|  (conditional-jump (< rs1 rs2) off))
        #|
        #|(defun BGEU (rs1 rs2 off)
        #|  "port: not in upstream."
        #|  (conditional-jump (>= rs1 rs2) off))
        #|
        #|(defun C_BEQ (rs1 rs2 off)
        #|  (conditional-jump (= rs1 rs2) off))
        #|
        #|(defun C_BLT (rs1 rs2 off)
        #|  (conditional-jump (s< rs1 rs2) off))
        #|
        #|(defun C_BNE (rs1 rs2 off)
        #|  (conditional-jump (/= rs1 rs2) off))
        #|
        #|(defun C_BGE (rs1 rs2 off)
        #|  (conditional-jump (s>= rs1 rs2) off))
        #|
        #|(defun BEQZ (rs1 off)
        #|  (conditional-jump (is-zero rs1) off))
        #|
        #|(defun C_BEQZ (rs1 off)
        #|  (conditional-jump (is-zero rs1) off))
        #|
        #|(defun BNEZ (rs1 off)
        #|  (conditional-jump (not (is-zero rs1)) off))
        #|
        #|(defun C_BNEZ (rs1 off)
        #|  (conditional-jump (not (is-zero rs1)) off))
        #|
        #|;;; No-ops and fences
        #|
        #|(defun C_NOP ()
        #|  (empty))
        #|
        #|(defun NOP ()
        #|  (empty))
        #|
        #|(defun FENCE (pred succ)
        #|  "port: not in upstream."
        #|  (empty))
        #|
        #|(defun FENCE_TSO ()
        #|  "port: not in upstream."
        #|  (empty))
        #|
        #|(defun FENCE_I ()
        #|  "port: not in upstream."
        #|  (empty))
        #|
      ),
    ),
    (
      "semantics/arm/aarch64-arithmetic.lisp",
      (
        #|(declare (context (target arm-family)
        #|                  (bits 64)))
        #|
        #|
        #|(in-package aarch64)
        #|
        #|;;; INTEGER ARITHMETIC OPERATIONS
        #|
        #|(defmacro ADD*r* (set shift-function rd rn imm-or-rm off)
        #|  "Implements ADD*ri and ADD*rs by specifying the shift function."
        #|  (set rd (+ rn (shift-function imm-or-rm off))))
        #|
        #|;; ADD*ri only uses lshift since the shift arg only zero-extends
        #|;; and doesn't actually change from lshift
        #|(defun ADDWri (rd rn imm off) (ADD*r* setw lshift rd rn imm off))
        #|(defun ADDXri (rd rn imm off) (ADD*r* set$ lshift rd rn imm off))
        #|;; shift-encoded decodes the shift type and shifts
        #|(defun ADDWrs (rd rn rm off) (ADD*r* setw shift-encoded rd rn rm off))
        #|(defun ADDXrs (rd rn rm off) (ADD*r* set$ shift-encoded rd rn rm off))
        #|
        #|(defun ADRP (dst imm)
        #|  (set$ dst (+
        #|             (logand (get-program-counter) (lshift -1 12))
        #|             (cast-signed (word) (lshift imm 12)))))
        #|
        #|(defmacro SUB*r* (set shift-function rd rn imm-or-rm off)
        #|  "Implements SUB*ri and SUB*rs by specifying the shift function."
        #|  (set rd (- rn (shift-function imm-or-rm off))))
        #|
        #|;; see ADD*ri vs ADD*rs
        #|(defun SUBWri (rd rn rm off) (SUB*r* setw lshift rd rn rm off))
        #|(defun SUBXri (rd rn rm off) (SUB*r* set$ lshift rd rn rm off))
        #|(defun SUBWrs (rd rn rm off) (SUB*r* setw shift-encoded rd rn rm off))
        #|(defun SUBXrs (rd rn rm off) (SUB*r* set$ shift-encoded rd rn rm off))
        #|
        #|(defun SUBXrx64 (rd rn rm off)
        #|  (set$ rd (- rn (extended rm off))))
        #|
        #|;; port: the flags of the W forms are computed on the low words (upstream
        #|;; computes them on 64-bit sign extensions)
        #|(defun SUBSWrs (rd rn rm off)
        #|  (adc32 rd rn (lnot (shift-encoded rm off)) 1))
        #|
        #|(defun SUBSXrs (rd rn rm off)
        #|  (adc64 rd rn (lnot (shift-encoded rm off)) 1))
        #|
        #|(defun SUBSWri (rd rn imm off)
        #|  (adc32 rd rn (lnot (lshift imm off)) 1))
        #|
        #|(defun SUBSXri (rd rn imm off)
        #|  (adc64 rd rn (lnot (lshift imm off)) 1))
        #|
        #|;; port: added, the flag-setting additions, the extended-register forms and
        #|;; the additions and subtractions with carry
        #|(defun ADDSWri (rd rn imm off) (adc32 rd rn (lshift imm off) 0))
        #|(defun ADDSXri (rd rn imm off) (adc64 rd rn (lshift imm off) 0))
        #|(defun ADDSWrs (rd rn rm off) (adc32 rd rn (shift-encoded rm off) 0))
        #|(defun ADDSXrs (rd rn rm off) (adc64 rd rn (shift-encoded rm off) 0))
        #|
        #|(defun ADDWrx (rd rn rm ext) (setw rd (+ rn (extended32 rm ext))))
        #|(defun ADDXrx (rd rn rm ext) (set$ rd (+ rn (extended rm ext))))
        #|(defun ADDXrx64 (rd rn rm ext) (set$ rd (+ rn (extended rm ext))))
        #|(defun SUBWrx (rd rn rm ext) (setw rd (- rn (extended32 rm ext))))
        #|(defun SUBXrx (rd rn rm ext) (set$ rd (- rn (extended rm ext))))
        #|(defun ADDSWrx (rd rn rm ext) (adc32 rd rn (extended32 rm ext) 0))
        #|(defun ADDSXrx (rd rn rm ext) (adc64 rd rn (extended rm ext) 0))
        #|(defun ADDSXrx64 (rd rn rm ext) (adc64 rd rn (extended rm ext) 0))
        #|(defun SUBSWrx (rd rn rm ext) (adc32 rd rn (lnot (extended32 rm ext)) 1))
        #|(defun SUBSXrx (rd rn rm ext) (adc64 rd rn (lnot (extended rm ext)) 1))
        #|(defun SUBSXrx64 (rd rn rm ext) (adc64 rd rn (lnot (extended rm ext)) 1))
        #|
        #|(defun ADCWr (rd rn rm) (setw rd (+ rn rm (cast-unsigned 32 CF))))
        #|(defun ADCXr (rd rn rm) (set$ rd (+ rn rm (cast-unsigned 64 CF))))
        #|(defun SBCWr (rd rn rm) (setw rd (+ rn (lnot rm) (cast-unsigned 32 CF))))
        #|(defun SBCXr (rd rn rm) (set$ rd (+ rn (lnot rm) (cast-unsigned 64 CF))))
        #|(defun ADCSWr (rd rn rm) (adc32 rd rn rm CF))
        #|(defun ADCSXr (rd rn rm) (adc64 rd rn rm CF))
        #|(defun SBCSWr (rd rn rm) (adc32 rd rn (lnot rm) CF))
        #|(defun SBCSXr (rd rn rm) (adc64 rd rn (lnot rm) CF))
        #|
        #|(defun ADR (dst imm)
        #|  "adr dst, imm ; port: added"
        #|  (set$ dst (+ (get-program-counter) (cast-signed 64 imm))))
        #|
        #|(defmacro Mop*rrr (set op rd rn rm ra)
        #|  "(Mop*rrr set op rd rn rm ra) implements multiply-add, multiply-subtract
        #|   etc with W or X registers. op is the binary operation used after *."
        #|  (set rd (op ra (* rn rm))))
        #|
        #|(defun MADDWrrr (rd rn rm ra) (Mop*rrr setw + rd rn rm ra))
        #|(defun MADDXrrr (rd rn rm ra) (Mop*rrr set$ + rd rn rm ra))
        #|(defun MSUBWrrr (rd rn rm ra) (Mop*rrr setw - rd rn rm ra))
        #|(defun MSUBXrrr (rd rn rm ra) (Mop*rrr set$ - rd rn rm ra))
        #|
        #|(defmacro *DIV*r (set div rd rn rm)
        #|  "(*DIV*r set div rd rn rm) implements the SDIV or UDIV instructions
        #|   on W or X registers, with div set to s/ or / respectively."
        #|  (if (= rm 0)
        #|    (set rd 0)
        #|    (set rd (div rn rm))))
        #|
        #|(defun SDIVWr (rd rn rm) (*DIV*r setw s/ rd rn rm))
        #|
        #|;; port: added, the long and high multiplies
        #|(defun SMADDLrrr (rd rn rm ra)
        #|  (set$ rd (+ ra (* (cast-signed 64 rn) (cast-signed 64 rm)))))
        #|(defun UMADDLrrr (rd rn rm ra)
        #|  (set$ rd (+ ra (* (cast-unsigned 64 rn) (cast-unsigned 64 rm)))))
        #|(defun SMSUBLrrr (rd rn rm ra)
        #|  (set$ rd (- ra (* (cast-signed 64 rn) (cast-signed 64 rm)))))
        #|(defun UMSUBLrrr (rd rn rm ra)
        #|  (set$ rd (- ra (* (cast-unsigned 64 rn) (cast-unsigned 64 rm)))))
        #|(defun SMULHrr (rd rn rm)
        #|  (set$ rd (cast-high 64 (* (cast-signed 128 rn) (cast-signed 128 rm)))))
        #|(defun UMULHrr (rd rn rm)
        #|  (set$ rd (cast-high 64 (* (cast-unsigned 128 rn) (cast-unsigned 128 rm)))))
        #|(defun SDIVXr (rd rn rm) (*DIV*r set$ s/ rd rn rm))
        #|(defun UDIVWr (rd rn rm) (*DIV*r setw /  rd rn rm))
        #|(defun UDIVXr (rd rn rm) (*DIV*r set$ /  rd rn rm))
        #|
      ),
    ),
    (
      "semantics/arm/aarch64-atomic.lisp",
      (
        #|(declare (context (target arm-family)
        #|                  (bits 64)))
        #|
        #|(in-package aarch64)
        #|
        #|;;; ATOMIC OPERATIONS
        #|
        #|(defmacro CASord* (set load store rs rt rn acquire release)
        #|  "(CASord* set load store rs rt rn acquire release)
        #|   implements a generic compare-and-swap instruction on a W or X register.
        #|   set is the function to assign to the size of rs and rt.
        #|   load and store are functions to load/store to/from the size of rs and rt.
        #|   acquire and release are booleans indicating whether load-acquire and
        #|   store-release ordering is to be enforced."
        #|   (let ((data (load rn)))
        #|    (when acquire (intrinsic 'load-acquire))
        #|    (when (= data rs)
        #|      (when release (intrinsic 'store-release))
        #|      (store rn rt))
        #|    (set rs data)))
        #|
        #|(defmacro store-hword (dst src) (store-word dst (cast-low 32 src)))
        #|(defmacro load-quarter-word (addr) (load-bits 16 addr))
        #|(defmacro store-quarter-word (dst src) (store-word dst (cast-low 16 src)))
        #|
        #|(defmacro CASordX (rs rt rn acquire release)
        #|  "Specialisation of CASord* for X registers."
        #|  (CASord* set$ load-word store-word rs rt rn acquire release))
        #|
        #|(defmacro CASordW (rs rt rn acquire release)
        #|  "Specialisation of CASord* for W registers."
        #|  (CASord* setw load-hword store-hword rs rt rn acquire release))
        #|
        #|(defmacro CASordB (rs rt rn acquire release)
        #|  "Specialisation of CASord* operating on individual bytes."
        #|  (CASord* setw memory-read store-byte rs rt rn acquire release))
        #|
        #|(defmacro CASordH (rs rt rn acquire release)
        #|  "Specialisation of CASord* for 16-bit values."
        #|  (CASord* setw load-quarter-word store-quarter-word rs rt rn acquire release))
        #|
        #|;; not sure why llvm returns 4 arguments.
        #|;; when i've tested it, the first and second arguments are always the same value
        #|;; so i'm just assuming they're the same and ignoring the second.
        #|(defun CASX   (rs _ rt rn) (CASordX rs rt rn false false))
        #|(defun CASAX  (rs _ rt rn) (CASordX rs rt rn true  false))
        #|(defun CASLX  (rs _ rt rn) (CASordX rs rt rn false true))
        #|(defun CASALX (rs _ rt rn) (CASordX rs rt rn true  true))
        #|
        #|(defun CASW   (rs _ rt rn) (CASordW rs rt rn false false))
        #|(defun CASAW  (rs _ rt rn) (CASordW rs rt rn true  false))
        #|(defun CASLW  (rs _ rt rn) (CASordW rs rt rn false true))
        #|(defun CASALW (rs _ rt rn) (CASordW rs rt rn true  true))
        #|
        #|(defun CASB   (rs _ rt rn) (CASordB rs rt rn false false))
        #|(defun CASAB  (rs _ rt rn) (CASordB rs rt rn true  false))
        #|(defun CASLB  (rs _ rt rn) (CASordB rs rt rn false true))
        #|(defun CASALB (rs _ rt rn) (CASordB rs rt rn true  true))
        #|
        #|(defun CASH   (rs _ rt rn) (CASordH rs rt rn false false))
        #|(defun CASAH  (rs _ rt rn) (CASordH rs rt rn true  false))
        #|(defun CASLH  (rs _ rt rn) (CASordH rs rt rn false true))
        #|(defun CASALH (rs _ rt rn) (CASordH rs rt rn true  true))
        #|
        #|
        #|(defmacro CSop*r (set op rd rn rm cnd)
        #|  "(CSop*r set op rd rn rm cnd) implements the conditional select
        #|   instruction on W or X registers, with op being applied to rm
        #|   when cnd is false."
        #|  (if (condition-holds cnd)
        #|    (set rd rn)
        #|    (set rd (op rm))))
        #|
        #|(defun id (arg) "identity function" (declare (visibility :private)) arg)
        #|
        #|(defun CSELWr  (rd rn rm cnd) (CSop*r setw id   rd rn rm cnd))
        #|(defun CSELXr  (rd rn rm cnd) (CSop*r set$ id   rd rn rm cnd))
        #|(defun CSINCWr (rd rn rm cnd) (CSop*r setw +1   rd rn rm cnd))
        #|(defun CSINCXr (rd rn rm cnd) (CSop*r set$ +1   rd rn rm cnd))
        #|(defun CSINVWr (rd rn rm cnd) (CSop*r setw lnot rd rn rm cnd))
        #|(defun CSINVXr (rd rn rm cnd) (CSop*r set$ lnot rd rn rm cnd))
        #|(defun CSNEGWr (rd rn rm cnd) (CSop*r setw neg  rd rn rm cnd))  ;; 2's complement negation
        #|(defun CSNEGXr (rd rn rm cnd) (CSop*r set$ neg  rd rn rm cnd))  ;; 2's complement negation
        #|
        #|;; port: added
        #|;; LSE atomic memory operations (rt rs rn): memory := op(old, rs),
        #|;; rt := old
        #|(defun LDADDX (rt rs rn)
        #|  (let ((old (load-word rn)))
        #|    (store-word rn (cast-low 64 (+ old rs)))
        #|    (set$ rt (cast-unsigned 64 old))))
        #|(defun LDADDW (rt rs rn)
        #|  (let ((old (load-bits 32 rn)))
        #|    (store-word rn (cast-low 32 (+ old (cast-low 32 rs))))
        #|    (setw rt (cast-unsigned 32 old))))
        #|(defun LDADDH (rt rs rn)
        #|  (let ((old (load-bits 16 rn)))
        #|    (store-word rn (cast-low 16 (+ old (cast-low 16 rs))))
        #|    (setw rt (cast-unsigned 32 old))))
        #|(defun LDADDB (rt rs rn)
        #|  (let ((old (load-bits 8 rn)))
        #|    (store-word rn (cast-low 8 (+ old (cast-low 8 rs))))
        #|    (setw rt (cast-unsigned 32 old))))
        #|(defun LDADDAX (rt rs rn)
        #|  (let ((old (load-word rn)))
        #|    (store-word rn (cast-low 64 (+ old rs)))
        #|    (set$ rt (cast-unsigned 64 old))))
        #|(defun LDADDAW (rt rs rn)
        #|  (let ((old (load-bits 32 rn)))
        #|    (store-word rn (cast-low 32 (+ old (cast-low 32 rs))))
        #|    (setw rt (cast-unsigned 32 old))))
        #|(defun LDADDAH (rt rs rn)
        #|  (let ((old (load-bits 16 rn)))
        #|    (store-word rn (cast-low 16 (+ old (cast-low 16 rs))))
        #|    (setw rt (cast-unsigned 32 old))))
        #|(defun LDADDAB (rt rs rn)
        #|  (let ((old (load-bits 8 rn)))
        #|    (store-word rn (cast-low 8 (+ old (cast-low 8 rs))))
        #|    (setw rt (cast-unsigned 32 old))))
        #|(defun LDADDALX (rt rs rn)
        #|  (let ((old (load-word rn)))
