        #|  (pmuly cast-signed dst src))
        #|
        #|(defun VPMULDQYrm (dst _ base scale index disp _)
        #|  (let ((off (+ disp (* scale index))))
        #|    (let ((src (load-dword (+ base off))))
        #|      (pmuly cast-signed dst src))))
