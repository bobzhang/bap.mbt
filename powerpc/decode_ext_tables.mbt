///|
fn ppc_o19(key : Int32) -> (String, String, String, UInt32)? {
  match key {
    0x24 => Some(("RFID", "", "rfid", 0x3fff800U))
    0x4c => Some(("RFMCI", "", "rfmci", 0x3fff800U))
    0x4e => Some(("RFDI", "", "rfdi", 0x3fff800U))
    0x64 => Some(("RFI", "", "rfi", 0x3fff800U))
    0x66 => Some(("RFCI", "", "rfci", 0x3fff800U))
    0x12c => Some(("ISYNC", "", "isync", 0x3fff800U))
    0x224 => Some(("HRFID", "", "hrfid", 0x3fff800U))
    0x2e4 => Some(("STOP", "", "stop", 0x3fff800U))
    0x364 => Some(("NAP", "", "nap", 0x3fff800U))
    0x20000004 =>
      Some(("ADDPCIS", "Reg:%X:t% Imm:%dx%", "addpcis %t%, %dx%", 0x0U))
    0x24000004 => Some(("ADDPCIS", "Reg:%X:t% Imm:0", "lnia %t%", 0x0U))
    _ => None
  }
}

///|
fn ppc_o17(key : Int32) -> (String, String, String, UInt32)? {
  match key {
    0x10000001 => Some(("SCV", "Imm:%l%", "scv %l%", 0x0U))
    0x10000002 => Some(("SC", "Imm:%l%", "sc %l%", 0x0U))
    0x14000001 => Some(("SCV", "Imm:0", "scv 0", 0x0U))
    0x14000002 => Some(("SC", "Imm:0", "sc", 0x0U))
    _ => None
  }
}

