// Differential semantic testing of the lifters against Unicorn.
//
// Each table (`*_cases_test.mbt`, generated by a throwaway script that is
// not committed) lists single instructions assembled by `llvm-mc` with a
// random initial state and the state Unicorn 2.1.4 computed after
// executing them (see the table headers for the few opcodes whose expected
// state comes from a model of the ISA instead). The harness decodes the
// encoding with the port's native decoder, lifts it with the lifter
// providers registered in an `@mc.Registry`, executes the BIL with
// `@types.exec_stmts` and compares every register of the table's register
// file, the next PC and the touched memory with the expected state.

///|
/// A single-instruction test. `init` lists the initial values of the
/// registers (all others start at zero), `out` the registers whose value
/// changes (all others must keep their initial value), `mem`/`mem_out` the
/// initial and changed memory regions, and `skip` the architecturally
/// undefined outputs (`R3`: the whole register, `R3:hi`: its upper half,
/// `CR0`: the `LT`/`GT`/`EQ` bits of `CR0`).
struct Case {
  text : String
  code : UInt
  init : Array[(String, UInt64)]
  out : Array[(String, UInt64)]
  mem : Array[(UInt64, Bytes)]
  mem_out : Array[(UInt64, Bytes)]
  skip : Array[String]
}

///|
fn hex_digit(c : Char) -> UInt64 {
  if c >= '0' && c <= '9' {
    (c.to_int() - '0'.to_int()).to_uint64()
  } else {
    (c.to_int() - 'a'.to_int() + 10).to_uint64()
  }
}

///|
fn parse_hex(s : StringView) -> UInt64 {
  let mut v = 0UL
  for c in s {
    v = (v << 4) | hex_digit(c)
  }
  v
}

///|
fn hex_bytes(s : StringView) -> Bytes {
  let chars = s.to_owned().to_array()
  Bytes::makei(chars.length() / 2, i => {
    ((hex_digit(chars[2 * i]) << 4) | hex_digit(chars[2 * i + 1])).to_byte()
  })
}

///|
fn words(s : StringView) -> Array[StringView] {
  s.split(" ").filter(w => !w.is_empty()).collect()
}

///|
/// Parse a table: one case per line, `text;code;init;out;mem;mem_out;skip`
/// with hexadecimal numbers, registers as `name=value` and memory regions
/// as `address:bytes` (trailing empty fields omitted).
fn parse_cases(table : String) -> Array[Case] raise {
  let cases = []
  for line in table.split("\n") {
    if line.is_empty() {
      continue
    }
    let fields : Array[StringView] = line.split(";").collect()
    let field = (i : Int) => fields.get(i).unwrap_or("")
    let regs = (s : StringView) => {
      words(s).map(w => {
        let parts : Array[StringView] = w.split("=").collect()
        (parts[0].to_owned(), parse_hex(parts[1]))
      })
    }
    let mems = (s : StringView) => {
      words(s).map(w => {
        let parts : Array[StringView] = w.split(":").collect()
        (parse_hex(parts[0]), hex_bytes(parts[1]))
      })
    }
    guard fields.length() >= 2 else { fail("bad case: \{line}") }
    cases.push({
      text: field(0).to_owned(),
      code: parse_hex(field(1)).to_uint(),
      init: regs(field(2)),
      out: regs(field(3)),
      mem: mems(field(4)),
      mem_out: mems(field(5)),
      skip: words(field(6)).map(w => w.to_owned()),
    })
  }
  cases
}

///|
/// How to run the tables of one ISA mode.
struct Isa {
  target : @core_theory.Target
  addr_width : Int
  /// address of the tested instruction
  pc : UInt64
  /// the instruction bytes of an encoding
  encode : (UInt) -> Bytes
  decode : (Bytes, UInt64) -> @mc.Insn?
  /// the register file compared by the tables (all set initially)
  regs : Array[String]
  write : (@types.BilState, String, UInt64) -> @types.BilState raise
  read : (@types.BilState, String) -> UInt64 raise
  /// the address control reaches when the instruction does not jump
  fallthrough : (@mc.Insn) -> UInt64
  /// bits of a register that are compared given the skip list
  care : (String, Array[String]) -> UInt64
}

///|
fn lookup(pairs : Array[(String, UInt64)], name : String) -> UInt64? {
  for pair in pairs {
    if pair.0 == name {
      return Some(pair.1)
    }
  }
  None
}

///|
fn default_care(name : String, skip : Array[String]) -> UInt64 {
  if skip.contains(name) {
    0
  } else if skip.contains(name + ":hi") {
    0xFFFF_FFFFUL
  } else {
    0xFFFF_FFFF_FFFF_FFFFUL
  }
}

///|
fn hex(v : UInt64) -> String {
  "0x" + v.to_string(radix=16)
}

///|
fn word(width : Int, v : UInt64) -> @types.BilValue raise {
  let v = if width >= 64 { v } else { v & ((1UL << width) - 1) }
  BilWord(@types.Word::of_uint64(width~, v))
}

///|
fn read_word(state : @types.BilState, name : String) -> UInt64 raise {
  guard state.get_word(name) is Some(w) else { fail("\{name} is unset") }
  w.to_uint64()
}

///|
/// Execute `stmts` until a jump; returns the state and the jump target.
fn step(
  stmts : Array[@types.Stmt],
  state : @types.BilState,
) -> (@types.BilState, UInt64?) raise {
  let mut state = state
  for stmt in stmts {
    match stmt {
      Jmp(dst) => {
        guard dst.eval_value(state.values()) is Ok(BilWord(w)) else {
          fail("bad jump target \{dst.to_string()}")
        }
        return (state, Some(w.to_uint64()))
      }
      If(cond~, yes~, no~) => {
        guard cond.eval_value(state.values()) is Ok(BilWord(c)) else {
          fail("bad condition \{cond.to_string()}")
        }
        let (next, target) = step(if c.is_zero() { no } else { yes }, state)
        state = next
        if target is Some(_) {
          return (state, target)
        }
      }
      _ =>
        match @types.exec_stmts([stmt], state~) {
          Ok(next) => state = next
          Err(msg) => fail("\{msg} in \{stmt.to_string()}")
        }
    }
  }
  (state, None)
}

///|
/// All the lifter providers.
let providers : @mc.Registry = {
  let r = @mc.Registry::new()
  @powerpc.register(registry=r)
  @mips.register(registry=r)
  @systemz.register(registry=r)
  @primus_lisp.register_semantics_providers(registry=r)
  r
}

///|
/// Run `c`; returns a description of each difference with the expected
/// state.
fn run_case(
  isa : Isa,
  c : Case,
  registry : @mc.Registry,
) -> Array[String] raise {
  let bytes = (isa.encode)(c.code)
  guard (isa.decode)(bytes, isa.pc) is Some(insn) else {
    return ["undecodable"]
  }
  let ctx = @mc.Context::create(isa.target)
  let bil = registry.lift(ctx, insn).bil() catch {
      e => fail("\{insn.name()}: \{e.message()}")
    }
  let mut state = @types.BilState::new()
  for r in isa.regs {
    state = (isa.write)(state, r, lookup(c.init, r).unwrap_or(0))
  }
  let mut mem = @types.BilMemory::empty(addr_width=isa.addr_width)
  for region in c.mem {
    let (start, data) = region
    for i, b in data {
      let addr = @types.Word::of_uint64(
        width=isa.addr_width,
        start + i.to_uint64(),
      )
      mem = match
        mem.store(
          addr,
          @types.Word::of_int(width=8, b.to_int()),
          endian=BigEndian,
        ) {
        Ok(m) => m
        Err(msg) => fail(msg)
      }
    }
  }
  state = state.set("mem", BilMem(mem))
  let (after, target) = step(bil, state)
  let diffs = []
  for r in isa.regs {
    let care = (isa.care)(r, c.skip)
    let expected = lookup(c.out, r).unwrap_or(lookup(c.init, r).unwrap_or(0))
    let actual = (isa.read)(after, r)
    if (actual & care) != (expected & care) {
      diffs.push("\{r}=\{hex(actual)} (expected \{hex(expected)})")
    }
  }
  let next = target.unwrap_or((isa.fallthrough)(insn))
  let expected_pc = lookup(c.out, "PC").unwrap_or(
    isa.pc + bytes.length().to_uint64(),
  )
  if next != expected_pc {
    diffs.push("PC=\{hex(next)} (expected \{hex(expected_pc)})")
  }
  guard after.get_memory("mem") is Some(mem) else { fail("memory lost") }
  let regions = if c.mem_out.is_empty() { c.mem } else { c.mem_out }
  for region in regions {
    let (start, expected) = region
    let actual = Bytes::makei(expected.length(), i => {
      mem.cell(start + i.to_uint64()).unwrap_or(0)
    })
    if actual != expected {
      diffs.push("mem[\{hex(start)}]=\{actual} (expected \{expected})")
    }
  }
  diffs
}

///|
/// Run every case of `table` whose text starts with `only`, lifting with
/// `registry`; fails listing all mismatching cases.
fn check(
  isa : Isa,
  table : String,
  registry? : @mc.Registry = providers,
  only? : String = "",
) -> Unit raise {
  let cases = parse_cases(table).filter(c => c.text.has_prefix(only))
  if cases.is_empty() {
    fail("no cases")
  }
  let failures = []
  for c in cases {
    let diffs = run_case(isa, c, registry) catch { err => [err.to_string()] }
    if !diffs.is_empty() {
      failures.push(
        "\{c.text} [\{hex(c.code.to_uint64())}]: \{diffs.join(", ")}",
      )
    }
  }
  if !failures.is_empty() {
    fail(
      "\{failures.length()}/\{cases.length()} cases differ:\n" +
      failures.join("\n"),
    )
  }
}
