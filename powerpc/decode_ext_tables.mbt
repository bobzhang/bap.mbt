///|
fn ppc_o63(key : Int32) -> (String, String, String, UInt32)? {
  match key {
    0x0 =>
      Some(
        (
          "FCMPUS", "Reg:CR%bf% Reg:%F:a% Reg:%F:b%", "fcmpu %bf%, %a%, %b%", 0x600000U,
        ),
      )
    0x4 =>
      Some(
        (
          "DADDQ", "Reg:Fpair%t% Reg:Fpair%a% Reg:Fpair%b%", "daddq %t%, %a%, %b%",
          0x210800U,
