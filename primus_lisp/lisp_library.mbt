        #|  (let ((x (read-xmm type insn:op1))
        #|        (y (read-word type (+ (reg-val insn:op2) insn:op5))))
        #|    (lower-all SF AF OF ZF CF PF)
        #|    (set ZF (ieee754-eq (type) x y))
        #|    (set CF (ieee754-lt (type) x y))
        #|    (exec-addr insn:next_address)))
