        #|  (extract (-1 (* (+1 n) (t))) (* n (t)) r))
        #|
        #|(defmacro sse-pack-low (tr tv r v)
        #|  (concat (extract (-1 (tr)) (tv) r) (sse-unpack tv 0 v)))
