///|
/// The kinds (LLVM's `MCInstrDesc` flags) of the table-decoded instructions.
fn ppc_ext_kinds(name : String) -> Array[@mc.Kind] {
  match name {
    "HASHCHK"
    | "HASHCHKP"
    | "LBARX"
    | "LBARXL"
    | "LDARX"
    | "LDARXL"
    | "LFD"
    | "LFDU"
    | "LFDUX"
    | "LFDX"
    | "LFIWAX"
    | "LFIWZX"
    | "LFS"
    | "LFSU"
    | "LFSUX"
    | "LFSX"
    | "LHARX"
    | "LHARXL"
    | "LMW"
    | "LQ"
    | "LQARX"
    | "LQARXL"
    | "LVEBX"
    | "LVEHX"
    | "LVEWX"
    | "LVX"
    | "LVXL"
    | "LWARX"
    | "LWARXL"
    | "LXSD"
    | "LXSDX"
    | "LXSIBZX"
    | "LXSIHZX"
