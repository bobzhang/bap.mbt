        #|        (w2 (extract-saturate kind 16  95 64 src1))
        #|        (w3 (extract-saturate kind 16 127 96 src1))
        #|        (w4 (extract-saturate kind 16  31  0 src2))
        #|        (w5 (extract-saturate kind 16  63 32 src2))
