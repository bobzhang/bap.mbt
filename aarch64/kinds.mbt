// Generated from LLVM 22's `MCInstrDesc` flags (the kinds upstream BAP
// reads), DO NOT EDIT.

///|
/// The kinds of the instruction named `name` (none for the unlisted ones).
fn a64_kinds(name : String) -> Array[@mc.Kind] {
