        #|;; xchgb reg, off(base)
        #|;; Reference: Vol. 2D 6-32
        #|
        #|(defun XCHG8rm (_ reg base scale index disp _)
        #|  (let ((off (+ disp (* scale index))))
        #|    (let ((p (+ base off))
        #|          (x (load-byte p)))
        #|      (store-byte p reg)
        #|      (set$ reg x))))
        #|
        #|(defun XCHG8rr (dst src _ _)
        #|  (let ((x dst))
        #|    (set$ dst src)
        #|    (set$ src x)))
        #|
      ),
